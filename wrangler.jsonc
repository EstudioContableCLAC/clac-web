{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "clac-web",
    "compatibility_date": "2026-05-24",
    "observability": {
      "enabled": true
    },
    "assets": {
      "directory": "dist/clac-web/browser",
      "not_found_handling": "single-page-application"
    },
    "compatibility_flags": [
      "nodejs_compat"
    ]
  }